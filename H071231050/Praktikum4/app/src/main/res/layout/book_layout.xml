<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <RelativeLayout
        android:id="@+id/layoutBook"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Book Cover Image with rounded corners -->
        <androidx.cardview.widget.CardView
            android:id="@+id/coverImageContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            
            <ImageView
                android:id="@+id/imgBook"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                android:contentDescription="Book cover image" />
        </androidx.cardview.widget.CardView>

        <!-- Book Title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/coverImageContainer"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Book Title"
            android:textColor="@color/dark_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Book Author -->
        <TextView
            android:id="@+id/txtAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtTitle"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Author Name"
            android:textColor="@color/medium_text"
            android:textSize="14sp" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
