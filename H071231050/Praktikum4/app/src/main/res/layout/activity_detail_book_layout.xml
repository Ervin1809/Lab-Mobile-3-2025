<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".Model.DetailBook">

    <!-- Header Image Area -->
    <ImageView
        android:id="@+id/imgBookDetail"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:contentDescription="Book cover image"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background" />

    <!-- Gradient Overlay -->
    <View
        android:id="@+id/gradientOverlay"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/year_badge_background" />

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/back"
        app:tint="@color/white" />

    <!-- Book Cover -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bookCoverCard"
        android:layout_width="140dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="180dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp">

        <ImageView
            android:id="@+id/imgBookCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />
    </androidx.cardview.widget.CardView>

    <!-- Content ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bookCoverCard"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- Title and Like Button -->
            <TextView
                android:id="@+id/txtBookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Book Title"
                android:textColor="@color/dark_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <!-- Author -->
            <TextView
                android:id="@+id/txtBookAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtBookTitle"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Author Name"
                android:textColor="@color/medium_text"
                android:textSize="18sp" />

            <!-- Year -->
            <TextView
                android:id="@+id/txtBookYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtBookAuthor"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp"
                android:background="@drawable/year_badge_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="2023"
                android:textColor="@color/dark_text"
                android:textSize="14sp" />

            <!-- Genres Section -->
            <TextView
                android:id="@+id/genresLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtBookYear"
                android:layout_marginTop="24dp"
                android:drawablePadding="8dp"
                android:text="Genres"
                android:textColor="@color/dark_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/genresScrollView"
                android:layout_below="@id/genresLabel"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:layout_height="wrap_content">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/genresLabel"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/genresContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/genres"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/genre_tag_background"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="Fantasy"
                            android:textColor="@color/dark_text" />
                    </LinearLayout>

                </HorizontalScrollView>

                <ImageView
                    android:id="@+id/btnLike"
                    android:layout_width="34sp"
                    android:layout_height="34sp"
                    android:src="@drawable/heart"
                    android:layout_marginLeft="6dp"
                    android:layout_gravity="center_vertical"
                    app:tint="@color/white"
                    />
            </LinearLayout>

            <!-- Synopsis Section -->
            <TextView
                android:id="@+id/synopsisLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/genresScrollView"
                android:layout_marginTop="24dp"
                android:drawablePadding="8dp"
                android:text="Synopsis"
                android:textColor="@color/dark_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/synopsisCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/synopsisLabel"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/txtBookBlurb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:padding="16dp"
                    android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fusce euismod, nisl nec aliquam convallis, nunc sapien aliquam arcu, nec tincidunt nisl nunc eget nunc. Nulla facilisi. Donec auctor, nisl eget aliquam convallis."
                    android:textColor="@color/medium_text"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <!-- Read Now Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReadNow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_below="@id/synopsisCard"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/accent"
                android:text="Read Now"
                android:textColor="@color/white"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
